{
  "name": "go-daily",
  "version": "1.3.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:puzzles && npm run validate:messages",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:puzzles": "tsx scripts/importTsumego.ts",
    "sync:puzzle-index": "tsx scripts/syncPuzzleIndex.ts",
    "validate:puzzles": "tsx scripts/validatePuzzles.ts",
    "validate:messages": "tsx scripts/validateMessages.ts",
    "preflight:prod": "tsx scripts/productionPreflight.ts",
    "audit:puzzles": "tsx scripts/auditPuzzles.ts",
    "report:duplicates": "tsx scripts/reportDuplicates.ts",
    "report:quality": "tsx scripts/reportQuality.ts",
    "queue:content": "tsx scripts/queueContent.ts",
    "plan:content-batch": "tsx scripts/planContentBatch.ts",
    "gemini:solutions": "node scripts/geminiSolutionNotes.js",
    "mimo:solutions": "node scripts/geminiSolutionNotes.js",
    "supabase:health": "tsx scripts/supabaseHealthcheck.ts",
    "email:smoketest": "tsx scripts/emailSmoketest.ts",
    "generate:icons": "tsx scripts/generateIcons.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.42.2",
    "idb-keyval": "^6.2.6",
    "lucide-react": "^1.23.0",
    "next": "16.3.2",
    "openai": "^6.45.0",
    "posthog-js": "^1.396.4",
    "posthog-node": "^5.39.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "next": {
      "postcss": "8.5.26"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
